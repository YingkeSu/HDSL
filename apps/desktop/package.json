{
  "name": "@hdsl/desktop",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Electron and React desktop app for managing local DeepSeek Harness environments.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "package:win": "electron-builder --win --x64 --dir",
    "package:win:nsis": "electron-builder --win nsis --x64",
    "package:mac": "electron-builder --mac --arm64"
  },
  "exports": {
    ".": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/main/qa-entry.*"
  ],
  "build": {
    "appId": "dev.hdsl.launcher",
    "productName": "HDSL",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/main/qa-entry.*",
      "!dist/renderer/testing/**",
      "!dist/**/*.map",
      "!node_modules/@hdsl/*/src/**",
      "!node_modules/@hdsl/*/dist/**/*.map",
      "!node_modules/@hdsl/contracts/dist/testing/**",
      "!node_modules/@hdsl/runtime/catalog/service-verifications/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools",
      "artifactName": "HDSL-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.hdsl.txt"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../packages/runtime/catalog",
        "to": "app/node_modules/@hdsl/runtime/catalog",
        "filter": [
          "dsh-*/package-lock.json"
        ]
      }
    ]
  },
  "dependencies": {
    "@hdsl/contracts": "workspace:*",
    "@hdsl/core": "workspace:*",
    "@hdsl/runtime": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
