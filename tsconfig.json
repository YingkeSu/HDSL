{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@hdsl/contracts/testing": ["./packages/contracts/src/testing/index.ts"],
      "@hdsl/contracts": ["./packages/contracts/src/index.ts"],
      "@hdsl/core": ["./packages/core/src/index.ts"],
      "@hdsl/runtime": ["./packages/runtime/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/src/**/*.cts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
